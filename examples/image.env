# Site settings for image/build.sh. Copy to /etc/ephemeral-runners/image.env
# and change to suit your jobs. Every setting is optional.

# Extra Debian packages your jobs need, space-separated.
EXTRA_PACKAGES="musl-tools"

# Rust toolchains to install with rustup, and extra targets for each.
# Leave RUST_TOOLCHAINS empty to leave Rust out of the image.
RUST_TOOLCHAINS="stable"
RUST_TARGETS="x86_64-unknown-linux-musl"

# Virtual disk size of each VM. The image file stays sparse.
DISK_SIZE=40G

# Where images are written, and how many to keep.
OUT_DIR=/var/lib/ephemeral-runners/images
KEEP_IMAGES=3

# A Prometheus textfile for the build's outcome: the time of the last build
# that succeeded, and the last exit code. Empty writes nothing.
METRICS_FILE=""
