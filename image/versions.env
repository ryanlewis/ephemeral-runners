# Pinned downloads for the runner image. Bump a version and its checksum together.

# https://github.com/actions/runner/releases
RUNNER_VERSION=2.338.2
RUNNER_SHA256=baebf204307bac6193480852732f0aba2ae97b6c5597c244f4d5558390147c40

# Used only when the site config lists Rust toolchains.
# https://static.rust-lang.org/rustup/archive/<version>/x86_64-unknown-linux-gnu/rustup-init.sha256
RUSTUP_VERSION=1.29.2
RUSTUP_SHA256=5be191e8c70a5007074254cb74d78dbfdd25cd5a61c27de7b8e5410122ec24f4

# Debian 13 genericcloud amd64 base image. Debian doesn't sign the current cloud
# images, so pin one build by hash. To bump: pick a dated directory under
# https://cloud.debian.org/images/cloud/trixie/, and take the hash from that
# directory's SHA512SUMS line for debian-13-genericcloud-amd64-<version>.qcow2.
# Debian has kept every dated build so far, so a stale pin keeps building from
# an old base without any error. Bump it to move the base forward.
DEBIAN_IMAGE_VERSION=20261026-2643
DEBIAN_IMAGE_SHA512=3ace18e33bdd036edb49d1f79342bd01d2ab980e35194edb0b410435cd543538d286a0bd13bbb0835f7862306e3d385ce2f6a70d8ecf0bd961111166adbc1b8e
