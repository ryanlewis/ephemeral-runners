#!/usr/bin/env bash
# Read the JIT config the host attached as a small disk with serial
# "jitconfig", then run one job as the runner user. Without the disk, wait
# for the host to hot-plug it: that is how a warm spare gets its job.
set -euo pipefail

disk=/dev/disk/by-id/virtio-jitconfig
if [[ ! -e $disk ]]; then
  echo "RUNNER-WAIT uptime=$(cut -d' ' -f1 /proc/uptime)" > /dev/ttyS0
  until [[ -e $disk ]]; do
    sleep 0.1
  done
fi

echo "RUNNER-START uptime=$(cut -d' ' -f1 /proc/uptime)" > /dev/ttyS0

jit=$(tr -d '\0' < "$disk")
cd /home/runner/actions-runner
exec runuser -u runner -- ./run.sh --jitconfig "$jit"
